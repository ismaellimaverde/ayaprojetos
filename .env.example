DATABASE_URL=postgresql://boss:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/boss
BETTER_AUTH_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
MAIL_MODE=local

# Hosting preparation only — set secrets through the approved host, never commit actual values.
# DATABASE_URL: dedicated server-role Supavisor transaction connection, server-side only.
# DATABASE_POOL_MAX=1
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=optional PEM certificate from the confirmed database provider
# BETTER_AUTH_URL=exact approved HTTPS origin, no wildcard or trailing slash
# BOSS_HOSTED=true (NETLIFY=true also enables hosted guards)
# MAIL_MODE=smtp
# EMAIL_DELIVERY_ENABLED=true (only after explicit delivery authorization)
# MAIL_FROM=approved sender
# SMTP_HOST=approved SMTP host
# SMTP_PORT=587
# SMTP_USER=server-side credential
# SMTP_PASSWORD=server-side credential

# Operator-only variables; never include migration credentials or authorization flags in Netlify:
# DATABASE_MIGRATION_URL=direct/session connection for the approved migration role
# DATABASE_OPERATOR_URL=direct/session connection for bootstrap
# DATABASE_RUNTIME_ROLE=existing dedicated non-superuser non-BYPASSRLS server role
# ALLOW_REMOTE_MIGRATION=yes
# ALLOW_REMOTE_BOOTSTRAP=yes
# CONFIRMED_DATABASE_HOST=exact approved operator-connection hostname
